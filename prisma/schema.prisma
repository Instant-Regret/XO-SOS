// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "mongodb"
    url      = env("DATABASE_URL")
}

model Post {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    createdBy   User   @relation(fields: [createdById], references: [id])
    createdById String @db.ObjectId

    @@index([name])
}

// Necessary for Next auth
model Account {
    id                       String  @id @default(auto()) @map("_id") @db.ObjectId
    userId                   String  @db.ObjectId
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String?
    access_token             String?
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String?
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    sessionToken String   @unique
    userId       String   @db.ObjectId
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]
    posts         Post[]
}

model VerificationToken {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// FRC data cached from The Blue Alliance + Statbotics.
// Refreshed weekly by the sync job; persisted indefinitely.

model District {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    key          String   @unique // e.g. "2024chs"
    abbreviation String
    displayName  String
    year         Int
    updatedAt    DateTime @updatedAt

    @@index([year])
}

model Event {
    id              String   @id @default(auto()) @map("_id") @db.ObjectId
    key             String   @unique // e.g. "2024chcmp"
    name            String
    eventType       Int // TBA event_type: 0=regional, 1=district, 2=district_cmp, ...
    eventTypeString String
    year            Int
    week            Int? // 0-indexed competition week; null for champs/offseason
    startDate       String?
    endDate         String?
    districtKey     String?
    updatedAt       DateTime @updatedAt

    @@index([year])
    @@index([eventType])
    @@index([districtKey])
}

model Team {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    number    Int      @unique
    key       String   @unique // "frc{number}"
    name      String? // full team name
    nickname  String?
    city      String?
    stateProv String?
    country   String?
    updatedAt DateTime @updatedAt
}

type EpaEntry {
    year        Int
    epaUnitless Float
}

// One document per team holding all historical (year, epa) entries.
model TeamEpa {
    id         String     @id @default(auto()) @map("_id") @db.ObjectId
    teamNumber Int        @unique
    epas       EpaEntry[]
    updatedAt  DateTime   @updatedAt
}

model EventTeam {
    id          String @id @default(auto()) @map("_id") @db.ObjectId
    eventKey    String @unique
    teamNumbers Int[]
}

model DistrictTeam {
    id          String @id @default(auto()) @map("_id") @db.ObjectId
    districtKey String @unique
    teamNumbers Int[]
}

type AvatarEntry {
    year   Int
    base64 String // raw base64-encoded PNG bytes, no data: prefix
}

// One document per team holding avatar bytes per year. Stored inline so the
// leaderboard query can return rows + avatars in a single round-trip.
model TeamAvatar {
    id         String        @id @default(auto()) @map("_id") @db.ObjectId
    teamNumber Int           @unique
    avatars    AvatarEntry[]
    updatedAt  DateTime      @updatedAt
}

type AwardEntry {
    eventKey  String
    awardType Int
    name      String
    year      Int
}

model Award {
    id         String       @id @default(auto()) @map("_id") @db.ObjectId
    teamNumber Int          @unique
    awards     AwardEntry[]
}

model SyncLog {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    task       String
    status     String // "success" | "error"
    message    String?
    startedAt  DateTime
    finishedAt DateTime

    @@index([task, startedAt])
}

// Shared, collaborative draft state. One document per (scopeKey, teamNumber).
// scopeKey is the board the pick belongs to — a districtKey ("2026chs"), an
// eventKey ("2026ausc"), or "global-{year}" for the top-100 view — so the same
// team can be drafted independently in a district and a regional.
model Pick {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    scopeKey   String
    year       Int
    teamNumber Int
    status     String // "available" | "ours" | "taken"
    by         String? // drafter handle (e.g. "@kai") when taken
    updatedBy  String? // user who last changed it
    updatedAt  DateTime @updatedAt

    @@unique([scopeKey, teamNumber])
    @@index([scopeKey])
}

// Per-year list of drafter handles used to populate the pick cycle.
model Draft {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    year      Int      @unique
    drafters  String[]
    updatedAt DateTime @updatedAt
}

// Stores the TBA ETag per request path so the next sync can send
// If-None-Match and skip unchanged endpoints (304 Not Modified).
model SyncCursor {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    path      String   @unique
    etag      String
    updatedAt DateTime @updatedAt
}

// Shared star ratings. Unlike picks, a rating is intrinsic to the team for a
// season, so it's keyed by (year, teamNumber) rather than by board.
model Rating {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    year       Int
    teamNumber Int
    stars      Int
    updatedBy  String?
    updatedAt  DateTime @updatedAt

    @@unique([year, teamNumber])
    @@index([year])
}

// Per (team, event) result inputs for SLFF scoring, pulled from TBA. One doc
// per team+event. Awards live in the Award model and are joined at compute time.
model TeamEventResult {
    id                String   @id @default(auto()) @map("_id") @db.ObjectId
    teamNumber        Int
    eventKey          String
    year              Int
    eventType         Int // TBA event_type (0=regional, 1=district, 2=dcmp, 3/4=champs, ...)
    startDate         String? // for ordering a team's first-2 events
    qualRank          Int?
    numTeams          Int? // field size, for the seeding formula
    allianceSeed      Int? // 1-8 if selected, else null
    pickRole          String? // "captain" | "pick1" | "pick2" | "pick3"
    elimMatchesPlayed Int      @default(0) // 5 pts each
    einsteinWins      Int      @default(0) // champs only, 5 pts each
    opponents         Int[] // distinct teams played with/against (for XSOS)
    updatedAt         DateTime @updatedAt

    @@unique([teamNumber, eventKey])
    @@index([year])
    @@index([eventKey])
}

// Computed SLFF scores per (team, year). Two windows: "std" = first 2 events +
// dcmp (region/district boards); "full" = all events (champs-division pages).
// Predicted (weighted-4-year) values are computed on read from prior years.
model TeamScore {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    teamNumber Int
    year       Int
    stdXrobot  Float    @default(0)
    stdXawards Float    @default(0)
    stdXval    Float    @default(0)
    fullXrobot Float    @default(0)
    fullXawards Float   @default(0)
    fullXval   Float    @default(0)
    xsos       Float? // strength-of-schedule percentile (0-100) within region
    updatedAt  DateTime @updatedAt

    @@unique([teamNumber, year])
    @@index([year])
}

// Prediction weights for the weighted-4-year XROBOT/XAWARDS. `opt*` are the
// regression-fitted optimum; `act*` are the editable active weights ("reset to
// optimal" copies opt -> act). Arrays are [w_{y-1}, w_{y-2}, w_{y-3}, w_{y-4}].
model ScoreWeights {
    id         String   @id @default(auto()) @map("_id") @db.ObjectId
    key        String   @unique @default("default")
    optRobot   Float[]
    optAwards  Float[]
    actRobot   Float[]
    actAwards  Float[]
    updatedAt  DateTime @updatedAt
}
